# Copie para .env.local (dev) ou .env (docker compose) e preencha.

# API GraphQL (backend)
NEXT_PUBLIC_API_URL=http://localhost:4000
# API Gateway das vagas (ex.: https://<id>.execute-api.us-east-1.amazonaws.com/prod)
NEXT_PUBLIC_SPOTS_API_URL=

# Mapbox (token público pk.*)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Stripe (chave publicável pk_*)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudinary (upload de imagens)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
